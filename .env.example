# 复制为 .env 后按需修改(iphonectl setup 会自动复制)。所有项都可以留空,用默认值。
# .env 里有通知密钥,不要提交到 git。

# 镜像:默认用发布的 ghcr.io/derrors/iphone-control-toolkit:latest;改成 iphone-control-toolkit:local 就从源码构建
IMAGE=
# 容器名;iphonectl 和 MCP 注册命令都用它
CONTAINER_NAME=iphone-control-toolkit
# 数据目录:配对记录、Apple ID 登录状态和开发私钥、证书、日志、锁屏密码。务必备份,不要提交
DATA_DIR=./data
# 数据目录归属的宿主机用户(id -u / id -g),这样不用 sudo 就能看日志
PUID=1000
PGID=1000

# WDA 端口,只监听 127.0.0.1
WDA_PORT=8100
# 实时画面的 MJPEG 流端口(iphonectl viewer 用),只监听 127.0.0.1;0 = 关闭
MJPEG_PORT=9100
# WebView 调试(Chrome DevTools Protocol)端口,只监听 127.0.0.1。默认关闭:开启后本机任何进程都能读取、
# 操作手机上已登录的 Safari 标签页。设成端口号(一般是 9222)开启
CDP_PORT=0
# 接了多台手机时指定要控制的那台;留空用第一台
IPHONE_UDID=
# WDA 不可用、且从没连上过 WDA 时,HID 后备路线换算坐标用的屏幕尺寸(点);一般留空
SCREEN_W=
SCREEN_H=

# 代理:下载开发者镜像、Apple ID 登录、构建镜像、发 Telegram 都会用;留空表示直连
HTTP_PROXY=
HTTPS_PROXY=
# 自建在局域网的 Bark 等不走代理的地址加在这里
NO_PROXY=localhost,127.0.0.1,::1

# 描述文件(免费账号 7 天有效)剩余不到几天时重签;每隔几小时检查一次
RESIGN_MIN_DAYS=2
RESIGN_CHECK_HOURS=6
# 手机离线超过几分钟推送提醒;0 表示不提醒
OFFLINE_ALERT_MIN=10

# 通知:配了哪个就发哪个。触发场景:重签失败、手机离线、重启后需要输密码、自动解锁失败
# Telegram:找 @BotFather 建 bot 拿 token;给 bot 发一句话后,打开
#   https://api.telegram.org/bot<token>/getUpdates 找 "chat":{"id":...}
TG_BOT_TOKEN=
TG_CHAT_ID=
# Bark:App 首页推送链接 https://api.day.app/XXXX/ 中间那段是 key;自建服务器改 BARK_SERVER
BARK_SERVER=https://api.day.app
BARK_KEY=
